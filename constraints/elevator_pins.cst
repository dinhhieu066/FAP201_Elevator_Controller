// =============================================================================
// Physical Constraints File: elevator_pins.cst
// Target Device: GW5A-LV25UG324C2/I1 (Xiaomeige ACG525 Gowin Kit)
// Project: Elevator Controller (FAP201)
// =============================================================================

// Clock 50MHz
IO_LOC "i_clk" T9;
IO_PORT "i_clk" PULL_MODE=NONE IO_TYPE=LVCMOS33;

// Active-Low Reset (KEY0)
IO_LOC "i_rst_n" B16;
IO_PORT "i_rst_n" PULL_MODE=UP IO_TYPE=LVCMOS33;

// Floor Request Buttons (KEY1, KEY2, and Expansion GPIOs)
IO_LOC "i_req_btn[0]" A15; // KEY1
IO_PORT "i_req_btn[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;

IO_LOC "i_req_btn[1]" C15; // KEY2
IO_PORT "i_req_btn[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;

IO_LOC "i_req_btn[2]" J14; // GPIO Pin
IO_PORT "i_req_btn[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;

IO_LOC "i_req_btn[3]" H14; // GPIO Pin
IO_PORT "i_req_btn[3]" PULL_MODE=UP IO_TYPE=LVCMOS33;

// Sensors (Anti-Pinch Door Sensor & Emergency Stop)
IO_LOC "i_door_sensor" G14;
IO_PORT "i_door_sensor" PULL_MODE=DOWN IO_TYPE=LVCMOS33;

IO_LOC "i_emergency_btn" F14;
IO_PORT "i_emergency_btn" PULL_MODE=DOWN IO_TYPE=LVCMOS33;

// Floor Indicator LEDs (LED0, LED1, LED2, LED3)
IO_LOC "o_led_floor[0]" D14; // LED0
IO_PORT "o_led_floor[0]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "o_led_floor[1]" C14; // LED1
IO_PORT "o_led_floor[1]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "o_led_floor[2]" B9;  // LED2
IO_PORT "o_led_floor[2]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "o_led_floor[3]" A9;  // LED3
IO_PORT "o_led_floor[3]" IO_TYPE=LVCMOS33 DRIVE=8;

// Status LEDs
IO_LOC "o_led_door" E15;
IO_PORT "o_led_door" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "o_led_emergency" D15;
IO_PORT "o_led_emergency" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "o_led_dir_up" B14;
IO_PORT "o_led_dir_up" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "o_led_dir_down" A14;
IO_PORT "o_led_dir_down" IO_TYPE=LVCMOS33 DRIVE=8;
